// 表单元素相关属性
// value:表单元素对应的值
// type:input 元素中的类型
// checked:选中状态
// selected:下拉菜单被选中的状态
// selectedIndex:下拉菜单中被选中元素对应的索引
// options：获取下拉菜单中所有的option项
// disabled:禁用属性

/*
<form action="" name="myform">
        请选择学生：<select name="sname">
            <option value="719">张三</option>
            <option value="720">李四</option>
            <option value="721">王五</option>
            <option value="722">赵六</option>
            <option value="723">周五</option>
        </select>

        宿舍为：<input type="text" name="room">
    </form>
    */
// 当我选择一个学生后，将其对应的宿舍号显示在文本框中

// 获取下拉菜单
let sel = document.myform.sname;
sel.onchange = function() {
    let val = sel.options[sel.selectedIndex].value;
    document.myform.room.value = val;
}

